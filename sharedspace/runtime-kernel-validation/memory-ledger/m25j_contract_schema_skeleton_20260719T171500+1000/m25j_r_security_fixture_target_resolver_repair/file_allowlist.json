{
  "allowed_paths": [
    "projects/durable-memory-architecture/contracts/m25j/**",
    "projects/durable-memory-architecture/test/m25j/**",
    "projects/durable-memory-architecture/scripts/m25j_validate_contracts.py",
    "sharedspace/runtime-kernel-validation/memory-ledger/m25j_contract_schema_skeleton_<timestamp>/**"
  ],
  "forbidden_paths": [
    "/home/stickai/.openclaw/openclaw.json",
    "/home/stickai/.openclaw/cron/**",
    "/home/stickai/.openclaw/extensions/**",
    "sharedspace/context-bridge/events.jsonl",
    "sharedspace/context-bridge/actions.json",
    "**/*.db",
    "**/*.sqlite",
    "**/*.wal",
    "**/*.shm",
    "**/*private*packet*"
  ],
  "schema": "stickbot.m25j.file_allowlist_and_test_matrix.v1",
  "terminal": "M25J_R_SECURITY_FIXTURE_TARGET_RESOLVER_CONTRACTS_PASS_NO_LIVE_DELIVERY",
  "tests": {
    "Broker/UMC": [
      "grant allow/deny/expiry/revocation",
      "bypass",
      "timeout/cancel",
      "forged receipt",
      "prose-success without receipt",
      "postcondition mismatch"
    ],
    "Context reconstruction": [
      "exact entity",
      "alias",
      "negative alias",
      "contradiction",
      "stale source",
      "missing unit",
      "unavailable private source",
      "malicious source instructions",
      "stale graph/index",
      "source changes after verification",
      "omission ledger"
    ],
    "Delivery": [
      "quiet success",
      "delivery-required payload ready",
      "handler allow",
      "handler hold",
      "handler reject",
      "missing closeout anchor",
      "missing terminal anchor",
      "missing completion anchor",
      "duplicate idempotency key",
      "Telegram failure",
      "delayed duplicate",
      "delivery-required bare NO_REPLY rejection"
    ],
    "Resilience": [
      "service crash",
      "Gateway restart",
      "partial evidence",
      "clock skew",
      "disk read-only/full for derived state",
      "source/graph/index watermark skew"
    ],
    "Schema and contract": [
      "valid",
      "malformed",
      "missing fields",
      "unknown major",
      "extension policy",
      "canonical hash",
      "replay",
      "duplicate receipt",
      "wrong surface/session/policy epoch"
    ],
    "Surface Response Target Resolver": [
      "valid owner-direct target request",
      "valid approved target grant",
      "valid resolved/HOLD/DENIED/EXPIRED receipts",
      "raw target marker rejection",
      "missing or ambiguous alias HOLD/no fallback",
      "identity/session verification required",
      "max deliveries exactly one",
      "wrong surface/session/identity/policy epoch denial",
      "delivery adapter contract requires target grant",
      "payload/target grant/delivery result scoped chain binding"
    ],
    "Surface/privacy": [
      "owner direct",
      "Web owner",
      "group/shared denial",
      "wrong identity/session",
      "private memory denial",
      "cross-surface replay",
      "redaction",
      "excerpt budget"
    ]
  }
}
