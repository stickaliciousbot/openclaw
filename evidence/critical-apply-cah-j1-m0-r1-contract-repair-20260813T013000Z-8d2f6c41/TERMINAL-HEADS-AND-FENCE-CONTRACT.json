{
  "completion_receipt_protocol": {
    "circularity_rule": "SUPERVISOR_CLOSED binds only immutable COMPLETION-RECEIPT-PREIMAGE.json hash; final receipt binds actual closeout head and the exact preimage, so no object hashes itself.",
    "commit": [
      "append exact precomputed SUPERVISOR_CLOSED",
      "fdatasync journal",
      "fsync parent when required",
      "reopen journal and verify sequence prev hash event payload and event hash",
      "journal is now closed"
    ],
    "precompute": [
      "freeze all preimage fields after lease release record",
      "canonicalize preimage_without_closeout_head",
      "compute preimage_sha256",
      "construct exact SUPERVISOR_CLOSED event with deterministic event_id sequence prev hash and payload binding preimage_sha256",
      "compute expected close event hash using frozen canonical journal hash algorithm",
      "persist and fsync COMPLETION-RECEIPT-PREIMAGE.json",
      "append COMPLETION_RECEIPT_PREIMAGE_RECORDED binding preimage hash if that event is part of the expected prev head, then recompute final close preimage exactly"
    ],
    "preimage_required_fields": [
      "schema",
      "transaction_id",
      "terminal_decision_head",
      "terminal_seal_sha256",
      "notification_outcome",
      "witness_outcome",
      "lease_release_outcome",
      "provider_effects",
      "production_effects",
      "expected_close_sequence",
      "expected_prev_event_sha256",
      "close_event_id",
      "close_event_payload_sha256"
    ],
    "publish_after_close": [
      "construct COMPLETION-RECEIPT.json from exact preimage plus closeout_head sequence and event_sha256",
      "atomic exclusive same-filesystem publication",
      "fdatasync receipt",
      "fsync parent",
      "reopen rehash and verify against preimage and actual close event",
      "release transaction lock only after verification"
    ],
    "recovery": "closed journal is authority; if SUPERVISOR_CLOSED exists and receipt is absent, reconstruct final receipt solely from verified preimage and actual close event without journal append; conflicting receipt is integrity HOLD and cannot rewrite semantics."
  },
  "heads": {
    "closeout_head": {
      "binds": [
        "terminal_decision_head",
        "terminal_seal_sha256",
        "notification_outcome",
        "witness_outcome",
        "lease_release_outcome",
        "provider_effects",
        "production_effects",
        "completion_receipt_preimage_sha256"
      ],
      "consumer": "COMPLETION-RECEIPT.json_published_after_close_event",
      "event": "SUPERVISOR_CLOSED",
      "meaning": "final canonical journal event; no append follows"
    },
    "semantic_reduction_head": {
      "consumer": "REDUCTION.json",
      "event": "TERMINAL_REDUCTION_PREPARED",
      "meaning": "frozen semantic prefix ending at fence"
    },
    "terminal_decision_head": {
      "binds": [
        "semantic_reduction_head",
        "reduction_sha256",
        "semantic_result"
      ],
      "consumers": [
        "MANIFEST.json",
        "TERMINAL-SEAL.json"
      ],
      "event": "TERMINAL_DECISION"
    }
  },
  "invariants": [
    "fence_is_committed_event_not_memory_flag",
    "reducer_reads_only_verified_journal_and_CAS",
    "terminal_decision_exactly_once_or_identical_idempotent_ACK",
    "seal_binds_terminal_decision_head_not_closeout_head",
    "closed_journal_rejects_all_append",
    "cleanup_and_owned_child_reconciliation_are_forbidden_after_fence",
    "completion_receipt_final_publication_occurs_after_SUPERVISOR_CLOSED_without_journal_append",
    "SUPERVISOR_CLOSED_event_hash_is_precomputed_from_exact_next_sequence_prev_hash_and_payload",
    "transaction_lock_released_only_after_final_receipt_verified"
  ],
  "mandatory_fence": {
    "allowed_post_freeze_event_types": [
      "TERMINAL_DECISION",
      "TERMINAL_SEAL_RECORDED",
      "NOTIFICATION_OUTCOME_RECORDED",
      "INDEPENDENT_WITNESS_RECORDED",
      "SCOPE_LEASE_RELEASE_INTENT",
      "SCOPE_LEASE_RELEASE_RECORDED",
      "COMPLETION_RECEIPT_PREIMAGE_RECORDED",
      "SUPERVISOR_CLOSED"
    ],
    "durable_ack_required": true,
    "event_type": "TERMINAL_REDUCTION_PREPARED",
    "events_rejected_after_fence": [
      "OWNED_CHILD_RECONCILIATION_RECORDED",
      "CLEANUP_RECORDED",
      "SEMANTIC_EVIDENCE_PROPOSED",
      "PASS_READINESS_CHANGED"
    ],
    "fields": [
      "semantic_input_closed",
      "freeze_sequence",
      "freeze_event_sha256",
      "contract_sha256",
      "reducer_sha256",
      "allowed_post_freeze_event_types"
    ],
    "post_fence_semantic_evidence": "REJECT_AND_INTEGRITY_HOLD",
    "semantic_input_closed": true,
    "terminal_seal_rule": "TERMINAL-SEAL.json is CAS-published after TERMINAL_DECISION; TERMINAL_SEAL_RECORDED is the canonical nonsemantic closeout event binding its hash."
  },
  "recovery": {
    "conflicting_terminal_decision": "INTEGRITY_FAULT_HOLD_NEVER_SEVERITY_PRECEDENCE",
    "crash_during_reduction": "replay_exact_verified_prefix_through_semantic_reduction_head_with_exact_reducer",
    "later_closeout_events": "cannot_rewrite_semantic_result"
  },
  "schema": "critical_apply.terminal_heads_and_fence_contract.v1.r1",
  "semantic_authority": "canonical_append_only_journal_only",
  "status": "FROZEN_FOR_M0_R1_B3_B4"
}
