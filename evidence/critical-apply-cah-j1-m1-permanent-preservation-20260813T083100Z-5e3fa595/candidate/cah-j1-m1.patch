+#!/usr/bin/env python3
+"""Authority-grade SQLite fencing and at-most-once nonce state.
+
+The canonical journal remains sole semantic authority. This database stores
+only cross-transaction exclusion/consumption facts and immutable hash-chained
+receipts. It deliberately has no PASS/HOLD/FAIL result columns.
+"""
+from __future__ import annotations
+
+import datetime as dt
+import hashlib
+import json
+import os
+import sqlite3
+import stat
+import uuid
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Any, Mapping, Sequence
+
+from critical_apply_contracts import canonical_json_dumps, is_sha256
+from critical_apply_journal import ValidatedJournal
+
+AUTHORITY_APPLICATION_ID = 0x43414831  # CAH1
+AUTHORITY_USER_VERSION = 1
+AUTHORITY_SCHEMA = "critical_apply.authoritydb.v1"
+BUSY_TIMEOUT_MS = 5000
+
+SCOPE_STATES = (
+    "RESERVED_PENDING_JOURNAL", "JOURNAL_COMMITTED", "ACTIVE", "RELEASE_PENDING", "RELEASED"
+)
+NONCE_STATES = (
+    "RESERVED_PENDING_JOURNAL", "COMMITTED_NOT_USED", "CALL_START_COMMITTED",
+    "OUTCOME_RECORDED", "RETIRED", "UNKNOWN_CONSUMED",
+)
+NORMATIVE_NONCE_TRANSITIONS = {
+    "N01": (None, "RESERVED_PENDING_JOURNAL", "DB_FIRST"),
+    "N02": ("RESERVED_PENDING_JOURNAL", "RESERVED_PENDING_JOURNAL", "JOURNAL_ONLY"),
+    "N03": ("RESERVED_PENDING_JOURNAL", "COMMITTED_NOT_USED", "JOURNAL_FIRST"),
+    "N04": ("COMMITTED_NOT_USED", "COMMITTED_NOT_USED", "JOURNAL_FIRST"),
+    "N05": ("COMMITTED_NOT_USED", "COMMITTED_NOT_USED", "JOURNAL_ONLY"),
+    "N06": ("COMMITTED_NOT_USED", "CALL_START_COMMITTED", "JOURNAL_FIRST"),
+    "N07": ("CALL_START_COMMITTED", "OUTCOME_RECORDED", "CAS_AND_JOURNAL_FIRST"),
+    "N08": ("CALL_START_COMMITTED", "UNKNOWN_CONSUMED", "DB_FIRST"),
+    "N09": ("OUTCOME_RECORDED", "RETIRED", "DB_FIRST"),
+    "N10": ("COMMITTED_NOT_USED", "RETIRED", "JOURNAL_FIRST"),
+    "N11": ("RESERVED_PENDING_JOURNAL", "RETIRED", "JOURNAL_FIRST"),
+}
+
+
+class AuthorityDBError(RuntimeError):
+    pass
+
+
+class AuthorityIntegrityError(AuthorityDBError):
+    pass
+
+
+class AuthorityBusyHold(AuthorityDBError):
+    pass
+
+
+class AuthorityConflict(AuthorityDBError):
+    pass
+
+
+@dataclass(frozen=True)
+class AuthorityReceipt:
+    schema: str
+    receipt_id: str
+    authority_receipt_sha256: str
+    record_kind: str
+    record_key_sha256: str
+    transition_ordinal: int
+    previous_receipt_sha256: str | None
+    from_state: str | None
+    to_state: str
+    transaction_id: str
+    origin_supervisor_epoch: str
+    supervisor_epoch: str
+    scope_hash: str | None
+    nonce_sha256: str | None
+    fencing_token: int
+    journal_sequence: int | None
+    journal_event_sha256: str | None
+    contract_sha256: str
+    request_sha256: str | None
+    db_generation_uuid: str
+    created_at_utc: str
+
+    def to_json(self) -> dict[str, Any]:
+        return dict(self.__dict__)
+
+
+SCHEMA_SQL = """
+CREATE TABLE db_metadata(key TEXT PRIMARY KEY, value TEXT NOT NULL) WITHOUT ROWID;
+CREATE TABLE scope_counters(scope_hash TEXT PRIMARY KEY, high_water INTEGER NOT NULL CHECK(high_water > 0)) WITHOUT ROWID;
+CREATE TABLE scope_lease_current(
+ scope_hash TEXT PRIMARY KEY, fencing_token INTEGER NOT NULL CHECK(fencing_token > 0), state TEXT NOT NULL CHECK(state IN ('RESERVED_PENDING_JOURNAL','JOURNAL_COMMITTED','ACTIVE','RELEASE_PENDING','RELEASED')),
+ transaction_id TEXT NOT NULL, origin_supervisor_epoch TEXT NOT NULL, supervisor_epoch TEXT NOT NULL,
+ contract_sha256 TEXT NOT NULL, transition_ordinal INTEGER NOT NULL CHECK(transition_ordinal > 0),
+ journal_sequence INTEGER, journal_event_sha256 TEXT, authority_receipt_sha256 TEXT NOT NULL,
+ UNIQUE(scope_hash,fencing_token), CHECK((state='RESERVED_PENDING_JOURNAL') OR (journal_sequence IS NOT NULL AND journal_event_sha256 IS NOT NULL))
+) WITHOUT ROWID;
+CREATE TABLE scope_lease_history(
+ scope_hash TEXT NOT NULL, fencing_token INTEGER NOT NULL, transition_ordinal INTEGER NOT NULL,
+ state TEXT NOT NULL, transaction_id TEXT NOT NULL, supervisor_epoch TEXT NOT NULL,
+ journal_sequence INTEGER, journal_event_sha256 TEXT, authority_receipt_sha256 TEXT NOT NULL,
+ PRIMARY KEY(scope_hash,fencing_token,transition_ordinal)
+) WITHOUT ROWID;
+CREATE TABLE nonce_current(
+ nonce_sha256 TEXT PRIMARY KEY, state TEXT NOT NULL CHECK(state IN ('RESERVED_PENDING_JOURNAL','COMMITTED_NOT_USED','CALL_START_COMMITTED','OUTCOME_RECORDED','RETIRED','UNKNOWN_CONSUMED')),
+ transaction_id TEXT NOT NULL, authority_id TEXT NOT NULL, origin_supervisor_epoch TEXT NOT NULL, supervisor_epoch TEXT NOT NULL,
+ authority_generation_token INTEGER NOT NULL CHECK(authority_generation_token > 0), contract_sha256 TEXT NOT NULL, request_sha256 TEXT NOT NULL,
+ transition_ordinal INTEGER NOT NULL CHECK(transition_ordinal > 0), journal_sequence INTEGER, journal_event_sha256 TEXT,
+ authority_receipt_sha256 TEXT NOT NULL,
+ CHECK((state='RESERVED_PENDING_JOURNAL') OR (journal_sequence IS NOT NULL AND journal_event_sha256 IS NOT NULL))
+) WITHOUT ROWID;
+CREATE TABLE nonce_history(
+ nonce_sha256 TEXT NOT NULL, transition_ordinal INTEGER NOT NULL, state TEXT NOT NULL,
+ transaction_id TEXT NOT NULL, supervisor_epoch TEXT NOT NULL, journal_sequence INTEGER, journal_event_sha256 TEXT,
+ authority_receipt_sha256 TEXT NOT NULL, PRIMARY KEY(nonce_sha256,transition_ordinal)
+) WITHOUT ROWID;
+CREATE TABLE authority_receipts(
+ receipt_id TEXT PRIMARY KEY, authority_receipt_sha256 TEXT NOT NULL UNIQUE,
+ record_kind TEXT NOT NULL CHECK(record_kind IN ('SCOPE_LEASE','NONCE')), record_key_sha256 TEXT NOT NULL,
+ transition_ordinal INTEGER NOT NULL, previous_receipt_sha256 TEXT, from_state TEXT, to_state TEXT NOT NULL,
+ transaction_id TEXT NOT NULL, origin_supervisor_epoch TEXT NOT NULL, supervisor_epoch TEXT NOT NULL,
+ scope_hash TEXT, nonce_sha256 TEXT, fencing_token INTEGER NOT NULL,
+ journal_sequence INTEGER, journal_event_sha256 TEXT, contract_sha256 TEXT NOT NULL, request_sha256 TEXT,
+ db_generation_uuid TEXT NOT NULL, created_at_utc TEXT NOT NULL, receipt_json TEXT NOT NULL
+) WITHOUT ROWID;
+CREATE TABLE recovery_quarantine(
+ quarantine_id TEXT PRIMARY KEY, record_kind TEXT NOT NULL, record_key_sha256 TEXT NOT NULL,
+ classification TEXT NOT NULL, created_at_utc TEXT NOT NULL
+) WITHOUT ROWID;
+CREATE UNIQUE INDEX one_scope_generation ON scope_lease_history(scope_hash,fencing_token,transition_ordinal);
+CREATE INDEX receipts_by_record ON authority_receipts(record_kind,record_key_sha256,transition_ordinal);
+"""
+
+
+def _utc() -> str:
+    return dt.datetime.now(dt.UTC).strftime("%Y-%m-%dT%H:%M:%SZ")
+
+
+def _schema_hash(con: sqlite3.Connection) -> str:
+    rows = con.execute("SELECT type,name,tbl_name,sql FROM sqlite_master WHERE name NOT LIKE 'sqlite_%' ORDER BY type,name").fetchall()
+    normalized = [[r[0], r[1], r[2], " ".join((r[3] or "").split())] for r in rows]
+    return hashlib.sha256(canonical_json_dumps({"schema": normalized}).encode()).hexdigest()
+
+
+def _mount_fstype(path: Path) -> str:
+    resolved = str(path.resolve(strict=True))
+    best = ("", "unknown")
+    try:
+        for line in Path("/proc/self/mountinfo").read_text().splitlines():
+            left, right = line.split(" - ", 1)
+            mountpoint = left.split()[4].replace("\\040", " ")
+            fstype = right.split()[0]
+            if (resolved == mountpoint or resolved.startswith(mountpoint.rstrip("/") + "/")) and len(mountpoint) > len(best[0]):
+                best = (mountpoint, fstype)
+    except (OSError, ValueError, IndexError):
+        pass
+    return best[1]
+
+
+def assert_authority_filesystem(path: Path) -> str:
+    path = Path(path).absolute()
+    parent = path.parent
+    parent.mkdir(mode=0o700, parents=True, exist_ok=True)
+    resolved_parent = parent.resolve(strict=True)
+    if str(resolved_parent).startswith("/mnt/c/") or str(resolved_parent) == "/mnt/c":
+        raise AuthorityDBError("AUTHORITY_FILESYSTEM_FORBIDDEN_DRVFS")
+    current = Path(resolved_parent.anchor)
+    for part in resolved_parent.parts[1:]:
+        current /= part
+        if stat.S_ISLNK(os.lstat(current).st_mode):
+            raise AuthorityDBError("AUTHORITY_PATH_SYMLINK_REJECTED")
+    parent_st = os.stat(resolved_parent)
+    if stat.S_IMODE(parent_st.st_mode) != 0o700:
+        raise AuthorityDBError("AUTHORITY_PARENT_MODE_NOT_0700")
+    if parent_st.st_uid != os.getuid():
+        raise AuthorityDBError("AUTHORITY_PARENT_OWNER_MISMATCH")
+    fstype = _mount_fstype(resolved_parent)
+    if fstype.lower() in {"9p", "drvfs", "nfs", "nfs4", "cifs", "smbfs", "fuse", "fuseblk"}:
+        raise AuthorityDBError(f"AUTHORITY_FILESYSTEM_FORBIDDEN:{fstype}")
+    return fstype
+
+
+def _event_value(event: Mapping[str, Any], key: str) -> Any:
+    if key in event:
+        return event[key]
+    for nested in ("authority", "payload", "cas_capture"):
+        value = event.get(nested)
+        if isinstance(value, Mapping) and key in value:
+            return value[key]
+    return None
+
+
+def find_event(validated: ValidatedJournal, event_type: str, **bindings: Any) -> Mapping[str, Any] | None:
+    if not validated.ok:
+        raise AuthorityIntegrityError("JOURNAL_NOT_VERIFIED")
+    for event in validated.events:
+        if event.get("event_type") == event_type and all(_event_value(event, k) == v for k, v in bindings.items()):
+            return event
+    return None
+
+
+def epoch_proven(validated: ValidatedJournal, epoch: str) -> bool:
+    return any(find_event(validated, t, supervisor_epoch=epoch) is not None for t in ("SUPERVISOR_STARTED", "SUPERVISOR_RECOVERED"))
+
+
+def _require_journal_context(validated: ValidatedJournal, transaction_id: str, epoch: str) -> None:
+    if not validated.ok:
+        raise AuthorityIntegrityError("JOURNAL_NOT_VERIFIED")
+    if validated.transaction_id != transaction_id:
+        raise AuthorityIntegrityError("JOURNAL_TRANSACTION_ID_MISMATCH")
+    if not epoch_proven(validated, epoch):
+        raise AuthorityIntegrityError("REJECT_MUTATION_EPOCH_NOT_PROVEN")
+
+
+def _require_event_common(event: Mapping[str, Any], *, contract_sha256: str, epoch: str) -> None:
+    if _event_value(event, "contract_sha256") != contract_sha256:
+        raise AuthorityIntegrityError("JOURNAL_CONTRACT_BINDING_MISMATCH")
+    if _event_value(event, "supervisor_epoch") != epoch:
+        raise AuthorityIntegrityError("JOURNAL_EPOCH_BINDING_MISMATCH")
+
+
+def _verify_cas_outcome_event(event: Mapping[str, Any]) -> None:
+    digest = event.get("payload_sha256")
+    rel = event.get("payload_path")
+    size = event.get("payload_byte_count")
+    capture = event.get("cas_capture")
+    if not isinstance(digest, str) or not is_sha256(digest):
+        raise AuthorityIntegrityError("OUTCOME_CAS_DIGEST_MISSING")
+    if rel != f"cas/{digest[:2]}/{digest}" or not isinstance(size, int) or size < 0:
+        raise AuthorityIntegrityError("OUTCOME_CAS_REFERENCE_INVALID")
+    if (
+        not isinstance(capture, Mapping)
+        or capture.get("schema") != "critical_apply.cas_capture.v1"
+        or capture.get("object_relative_path") != rel
+    ):
+        raise AuthorityIntegrityError("OUTCOME_CAS_CAPTURE_BINDING_MISSING")
+    if _event_value(event, "response_sha256") != digest:
+        raise AuthorityIntegrityError("OUTCOME_RESPONSE_DIGEST_BINDING_MISMATCH")
+
+
+class AuthorityDB:
+    def __init__(self, path: Path, *, busy_timeout_ms: int = BUSY_TIMEOUT_MS):
+        self.path = Path(path).absolute()
+        self.fstype = assert_authority_filesystem(self.path)
+        self.busy_timeout_ms = busy_timeout_ms
+        created = False
+        try:
+            leaf_fd = os.open(
+                self.path,
+                os.O_RDWR | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0),
+                0o600,
+            )
+            created = True
+            os.close(leaf_fd)
+        except FileExistsError:
+            leaf_st = os.lstat(self.path)
+            if stat.S_ISLNK(leaf_st.st_mode) or not stat.S_ISREG(leaf_st.st_mode):
+                raise AuthorityDBError("AUTHORITY_DB_LEAF_NOT_REGULAR")
+            if leaf_st.st_uid != os.getuid() or stat.S_IMODE(leaf_st.st_mode) != 0o600:
+                raise AuthorityDBError("AUTHORITY_DB_IDENTITY_OR_MODE_MISMATCH")
+        self.con = self._connect()
+        try:
+            self._pragmas()
+            if created:
+                self._begin()
+                try:
+                    for statement in SCHEMA_SQL.split(";"):
+                        if statement.strip():
+                            self.con.execute(statement)
+                    self.con.execute(f"PRAGMA application_id={AUTHORITY_APPLICATION_ID}")
+                    self.con.execute(f"PRAGMA user_version={AUTHORITY_USER_VERSION}")
+                    generation = str(uuid.uuid4())
+                    shash = _schema_hash(self.con)
+                    self.con.executemany("INSERT INTO db_metadata VALUES(?,?)", (
+                        ("schema", AUTHORITY_SCHEMA), ("schema_hash", shash), ("db_generation_uuid", generation),
+                        ("sqlite_version", sqlite3.sqlite_version), ("filesystem_type", self.fstype),
+                    ))
+                    self._commit()
+                except Exception:
+                    if self.con.in_transaction:
+                        self.con.rollback()
+                    raise
+                db_fd = os.open(self.path, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
+                try:
+                    os.fsync(db_fd)
+                finally:
+                    os.close(db_fd)
+                pfd = os.open(self.path.parent, os.O_RDONLY | os.O_DIRECTORY | getattr(os, "O_NOFOLLOW", 0))
+                try:
+                    os.fsync(pfd)
+                finally:
+                    os.close(pfd)
+                # Creation is acknowledged only after a new connection reasserts
+                # WAL/FULL and verifies exact identity, versions, schema and chains.
+                self.con.close()
+                self.con = self._connect()
+                self._pragmas()
+            self.assert_ready()
+        except Exception:
+            self.con.close()
+            raise
+
+    def _connect(self) -> sqlite3.Connection:
+        return sqlite3.connect(self.path, timeout=self.busy_timeout_ms / 1000, isolation_level=None)
+
+    def _pragmas(self) -> None:
+        def one(sql: str) -> Any: return self.con.execute(sql).fetchone()[0]
+        if str(one("PRAGMA journal_mode=WAL")).lower() != "wal": raise AuthorityDBError("WAL_NOT_ACTIVE")
+        self.con.execute("PRAGMA synchronous=FULL")
+        self.con.execute("PRAGMA foreign_keys=ON")
+        self.con.execute("PRAGMA trusted_schema=OFF")
+        self.con.execute("PRAGMA locking_mode=NORMAL")
+        self.con.execute(f"PRAGMA busy_timeout={self.busy_timeout_ms}")
+        self.con.execute("PRAGMA wal_autocheckpoint=1000")
+        self.con.execute("PRAGMA temp_store=MEMORY")
+        self.con.execute("PRAGMA secure_delete=FAST")
+        if one("PRAGMA synchronous") != 2 or one("PRAGMA foreign_keys") != 1 or one("PRAGMA trusted_schema") != 0:
+            raise AuthorityDBError("REQUIRED_PRAGMA_ASSERTION_FAILED")
+
+    def assert_ready(self) -> None:
+        if str(self.con.execute("PRAGMA journal_mode").fetchone()[0]).lower() != "wal": raise AuthorityIntegrityError("WAL_NOT_ACTIVE_ON_REOPEN")
+        if self.con.execute("PRAGMA synchronous").fetchone()[0] != 2: raise AuthorityIntegrityError("SYNCHRONOUS_FULL_NOT_ACTIVE_ON_REOPEN")
+        if self.con.execute("PRAGMA application_id").fetchone()[0] != AUTHORITY_APPLICATION_ID: raise AuthorityIntegrityError("APPLICATION_ID_MISMATCH")
+        if self.con.execute("PRAGMA user_version").fetchone()[0] != AUTHORITY_USER_VERSION: raise AuthorityIntegrityError("USER_VERSION_MISMATCH")
+        if self.con.execute("PRAGMA quick_check").fetchone()[0] != "ok": raise AuthorityIntegrityError("QUICK_CHECK_FAILED")
+        if self.con.execute("PRAGMA foreign_key_check").fetchall(): raise AuthorityIntegrityError("FOREIGN_KEY_CHECK_FAILED")
+        metadata = dict(self.con.execute("SELECT key,value FROM db_metadata"))
+        if metadata.get("schema") != AUTHORITY_SCHEMA or metadata.get("schema_hash") != _schema_hash(self.con):
+            raise AuthorityIntegrityError("SCHEMA_HASH_MISMATCH")
+        if stat.S_IMODE(os.stat(self.path).st_mode) != 0o600: raise AuthorityIntegrityError("AUTHORITY_DB_MODE_NOT_0600")
+        self.verify_receipt_chains()
+
+    @property
+    def generation(self) -> str:
+        return self.con.execute("SELECT value FROM db_metadata WHERE key='db_generation_uuid'").fetchone()[0]
+
+    def close(self) -> None:
+        self.con.close()
+
+    def __enter__(self) -> "AuthorityDB": return self
+    def __exit__(self, *_: object) -> None: self.close()
+
+    def _begin(self) -> None:
+        try: self.con.execute("BEGIN IMMEDIATE")
+        except sqlite3.OperationalError as exc:
+            raise AuthorityBusyHold("SQLITE_BUSY_OR_LOCKED_NO_ACTION") from exc
+
+    def _commit(self) -> None:
+        try: self.con.commit()
+        except sqlite3.Error as exc:
+            try: self.con.rollback()
+            except sqlite3.Error: pass
+            raise AuthorityIntegrityError("UNKNOWN_AUTHORITY_COMMIT") from exc
+
+    def _make_receipt(self, *, kind: str, key: str, ordinal: int, previous: str | None, from_state: str | None,
+                      to_state: str, transaction_id: str, origin_epoch: str, epoch: str, token: int,
+                      contract_sha256: str, request_sha256: str | None = None, journal_event: Mapping[str, Any] | None = None) -> AuthorityReceipt:
+        body = {
+            "schema": "critical_apply.authority_receipt.v1",
+            "receipt_id": str(uuid.uuid4()), "record_kind": kind, "record_key_sha256": key,
+            "transition_ordinal": ordinal, "previous_receipt_sha256": previous, "from_state": from_state,
+            "to_state": to_state, "transaction_id": transaction_id, "origin_supervisor_epoch": origin_epoch,
+            "supervisor_epoch": epoch, "scope_hash": key if kind == "SCOPE_LEASE" else None,
+            "nonce_sha256": key if kind == "NONCE" else None, "fencing_token": token,
+            "journal_sequence": int(journal_event["sequence"]) if journal_event else None,
+            "journal_event_sha256": str(journal_event["event_sha256"]) if journal_event else None,
+            "contract_sha256": contract_sha256, "request_sha256": request_sha256,
+            "db_generation_uuid": self.generation, "created_at_utc": _utc(),
+        }
+        digest = hashlib.sha256(canonical_json_dumps(body).encode()).hexdigest()
+        return AuthorityReceipt(authority_receipt_sha256=digest, **body)
+
+    def _insert_receipt(self, r: AuthorityReceipt) -> None:
+        j = r.to_json()
+        self.con.execute("INSERT INTO authority_receipts VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)", (
+            r.receipt_id, r.authority_receipt_sha256, r.record_kind, r.record_key_sha256, r.transition_ordinal,
+            r.previous_receipt_sha256, r.from_state, r.to_state, r.transaction_id, r.origin_supervisor_epoch,
+            r.supervisor_epoch, r.scope_hash, r.nonce_sha256, r.fencing_token, r.journal_sequence,
+            r.journal_event_sha256, r.contract_sha256, r.request_sha256, r.db_generation_uuid,
+            r.created_at_utc, canonical_json_dumps(j),
+        ))
+
+    def _reread_receipt(self, sha: str) -> AuthorityReceipt:
+        row = self.con.execute("SELECT receipt_json FROM authority_receipts WHERE authority_receipt_sha256=?", (sha,)).fetchone()
+        if row is None: raise AuthorityIntegrityError("COMMITTED_RECEIPT_REREAD_MISSING")
+        data = json.loads(row[0])
+        if data.get("authority_receipt_sha256") != sha: raise AuthorityIntegrityError("COMMITTED_RECEIPT_REREAD_MISMATCH")
+        return AuthorityReceipt(**data)
+
+    def reserve_scope(self, *, validated: ValidatedJournal, scope_hash: str, transaction_id: str, supervisor_epoch: str, contract_sha256: str) -> AuthorityReceipt:
+        _require_hashes(scope_hash, contract_sha256)
+        _require_journal_context(validated, transaction_id, supervisor_epoch)
+        self._begin()
+        try:
+            current = self.con.execute("SELECT state,transition_ordinal,authority_receipt_sha256 FROM scope_lease_current WHERE scope_hash=?", (scope_hash,)).fetchone()
+            if current and current[0] != "RELEASED": raise AuthorityConflict("SCOPE_ALREADY_CURRENT")
+            prior = self.con.execute("SELECT high_water FROM scope_counters WHERE scope_hash=?", (scope_hash,)).fetchone()
+            token = (prior[0] if prior else 0) + 1
+            ordinal = (current[1] if current else 0) + 1
+            previous = current[2] if current else None
+            if prior: self.con.execute("UPDATE scope_counters SET high_water=? WHERE scope_hash=?", (token, scope_hash))
+            else: self.con.execute("INSERT INTO scope_counters VALUES(?,?)", (scope_hash, token))
+            r = self._make_receipt(kind="SCOPE_LEASE", key=scope_hash, ordinal=ordinal, previous=previous, from_state=None,
+                to_state="RESERVED_PENDING_JOURNAL", transaction_id=transaction_id, origin_epoch=supervisor_epoch,
+                epoch=supervisor_epoch, token=token, contract_sha256=contract_sha256)
+            self._insert_receipt(r)
+            self.con.execute("INSERT OR REPLACE INTO scope_lease_current VALUES(?,?,?,?,?,?,?,?,?,?,?)", (
+                scope_hash, token, r.to_state, transaction_id, supervisor_epoch, supervisor_epoch, contract_sha256,
+                ordinal, None, None, r.authority_receipt_sha256))
+            self.con.execute("INSERT INTO scope_lease_history VALUES(?,?,?,?,?,?,?,?,?)", (scope_hash, token, ordinal, r.to_state, transaction_id, supervisor_epoch, None, None, r.authority_receipt_sha256))
+            self._commit()
+        except Exception:
+            if self.con.in_transaction: self.con.rollback()
+            raise
+        return self._reread_receipt(r.authority_receipt_sha256)
+
+    def _scope_transition(self, *, validated: ValidatedJournal, scope_hash: str, epoch: str, expected: str, target: str, journal_type: str | None) -> AuthorityReceipt:
+        self._begin()
+        try:
+            row = self.con.execute("SELECT * FROM scope_lease_current WHERE scope_hash=?", (scope_hash,)).fetchone()
+            if row is None or row[2] != expected: raise AuthorityConflict(f"SCOPE_STATE_NOT_{expected}")
+            _require_journal_context(validated, row[3], epoch)
+            event = None
+            if journal_type:
+                event = find_event(
+                    validated,
+                    journal_type,
+                    scope_hash=scope_hash,
+                    fencing_token=row[1],
+                    authority_receipt_sha256=row[10],
+                )
+                if event is None: raise AuthorityIntegrityError("REQUIRED_JOURNAL_EVENT_NOT_PROVEN")
+                _require_event_common(event, contract_sha256=row[6], epoch=epoch)
+            ordinal = row[7] + 1
+            r = self._make_receipt(kind="SCOPE_LEASE", key=scope_hash, ordinal=ordinal, previous=row[10], from_state=expected,
+                to_state=target, transaction_id=row[3], origin_epoch=row[4], epoch=epoch, token=row[1], contract_sha256=row[6], journal_event=event or ({"sequence":row[8],"event_sha256":row[9]} if row[8] else None))
+            self._insert_receipt(r)
+            self.con.execute("UPDATE scope_lease_current SET state=?,supervisor_epoch=?,transition_ordinal=?,journal_sequence=?,journal_event_sha256=?,authority_receipt_sha256=? WHERE scope_hash=?",
+                (target, epoch, ordinal, r.journal_sequence, r.journal_event_sha256, r.authority_receipt_sha256, scope_hash))
+            self.con.execute("INSERT INTO scope_lease_history VALUES(?,?,?,?,?,?,?,?,?)", (scope_hash,row[1],ordinal,target,row[3],epoch,r.journal_sequence,r.journal_event_sha256,r.authority_receipt_sha256))
+            self._commit()
+        except Exception:
+            if self.con.in_transaction: self.con.rollback()
+            raise
+        return self._reread_receipt(r.authority_receipt_sha256)
+
+    def bind_scope_reservation(self, **kw: Any) -> AuthorityReceipt: return self._scope_transition(expected="RESERVED_PENDING_JOURNAL", target="JOURNAL_COMMITTED", journal_type="SCOPE_LEASE_RESERVATION_COMMITTED", **kw)
+    def activate_scope(self, **kw: Any) -> AuthorityReceipt: return self._scope_transition(expected="JOURNAL_COMMITTED", target="ACTIVE", journal_type=None, **kw)
+    def begin_scope_release(self, **kw: Any) -> AuthorityReceipt: return self._scope_transition(expected="ACTIVE", target="RELEASE_PENDING", journal_type="SCOPE_LEASE_RELEASE_INTENT", **kw)
+    def finish_scope_release(self, **kw: Any) -> AuthorityReceipt: return self._scope_transition(expected="RELEASE_PENDING", target="RELEASED", journal_type=None, **kw)
+
+    def scope_action_allowed(self, *, validated: ValidatedJournal, scope_hash: str, transaction_id: str, supervisor_epoch: str, fencing_token: int) -> bool:
+        row = self.con.execute("SELECT * FROM scope_lease_current WHERE scope_hash=?", (scope_hash,)).fetchone()
+        if row is None or row[2] != "ACTIVE" or row[1] != fencing_token or row[3] != transaction_id or row[5] != supervisor_epoch: return False
+        if validated.transaction_id != transaction_id:
+            return False
+        acquired = find_event(
+            validated, "SCOPE_LEASE_ACQUIRED", scope_hash=scope_hash, fencing_token=fencing_token,
+            authority_receipt_sha256=row[10], contract_sha256=row[6], supervisor_epoch=supervisor_epoch,
+        )
+        release = find_event(validated, "SCOPE_LEASE_RELEASE_INTENT", scope_hash=scope_hash, fencing_token=fencing_token)
+        return acquired is not None and release is None and epoch_proven(validated, supervisor_epoch)
+
+    def reserve_nonce(self, *, validated: ValidatedJournal, nonce_sha256: str, transaction_id: str, authority_id: str,
+                      supervisor_epoch: str, authority_generation_token: int, contract_sha256: str, request_sha256: str) -> AuthorityReceipt:
+        _require_hashes(nonce_sha256, contract_sha256, request_sha256)
+        _require_journal_context(validated, transaction_id, supervisor_epoch)
+        self._begin()
+        try:
+            if self.con.execute("SELECT 1 FROM nonce_current WHERE nonce_sha256=?", (nonce_sha256,)).fetchone(): raise AuthorityConflict("NONCE_ALREADY_RESERVED")
+            r = self._make_receipt(kind="NONCE", key=nonce_sha256, ordinal=1, previous=None, from_state=None, to_state="RESERVED_PENDING_JOURNAL",
+                transaction_id=transaction_id, origin_epoch=supervisor_epoch, epoch=supervisor_epoch, token=authority_generation_token,
+                contract_sha256=contract_sha256, request_sha256=request_sha256)
+            self._insert_receipt(r)
+            self.con.execute("INSERT INTO nonce_current VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?)", (nonce_sha256,r.to_state,transaction_id,authority_id,supervisor_epoch,supervisor_epoch,authority_generation_token,contract_sha256,request_sha256,1,None,None,r.authority_receipt_sha256))
+            self.con.execute("INSERT INTO nonce_history VALUES(?,?,?,?,?,?,?,?)", (nonce_sha256,1,r.to_state,transaction_id,supervisor_epoch,None,None,r.authority_receipt_sha256))
+            self._commit()
+        except Exception:
+            if self.con.in_transaction: self.con.rollback()
+            raise
+        return self._reread_receipt(r.authority_receipt_sha256)
+
+    def _nonce_transition(
+        self, *, validated: ValidatedJournal, nonce_sha256: str, epoch: str, expected: str, target: str,
+        journal_type: str | None, required_event_bindings: Mapping[str, Any] | None = None,
+        require_cas_outcome: bool = False,
+    ) -> AuthorityReceipt:
+        self._begin()
+        try:
+            row = self.con.execute("SELECT * FROM nonce_current WHERE nonce_sha256=?", (nonce_sha256,)).fetchone()
+            if row is None or row[1] != expected: raise AuthorityConflict(f"NONCE_STATE_NOT_{expected}")
+            if expected in ("RETIRED", "UNKNOWN_CONSUMED"): raise AuthorityConflict("NONCE_TERMINAL_NONRETRYABLE")
+            _require_journal_context(validated, row[2], epoch)
+            event = None
+            if journal_type:
+                event = find_event(validated, journal_type, nonce_sha256=nonce_sha256)
+                if event is None: raise AuthorityIntegrityError("REQUIRED_JOURNAL_EVENT_NOT_PROVEN")
+                _require_event_common(event, contract_sha256=row[7], epoch=epoch)
+                if _event_value(event, "authority_receipt_sha256") != row[12]:
+                    raise AuthorityIntegrityError("JOURNAL_PRIOR_RECEIPT_BINDING_MISMATCH")
+                if _event_value(event, "request_sha256") != row[8]:
+                    raise AuthorityIntegrityError("NONCE_REQUEST_BINDING_MISMATCH")
+                if _event_value(event, "authority_id") != row[3]:
+                    raise AuthorityIntegrityError("NONCE_AUTHORITY_BINDING_MISMATCH")
+                for key, value in (required_event_bindings or {}).items():
+                    if _event_value(event, key) != value:
+                        raise AuthorityIntegrityError(f"JOURNAL_REQUIRED_BINDING_MISMATCH:{key}")
+                if require_cas_outcome:
+                    _verify_cas_outcome_event(event)
+            inherited = {"sequence":row[10],"event_sha256":row[11]} if row[10] else None
+            ordinal = row[9] + 1
+            r = self._make_receipt(kind="NONCE", key=nonce_sha256, ordinal=ordinal, previous=row[12], from_state=expected, to_state=target,
+                transaction_id=row[2], origin_epoch=row[4], epoch=epoch, token=row[6], contract_sha256=row[7], request_sha256=row[8], journal_event=event or inherited)
+            self._insert_receipt(r)
+            self.con.execute("UPDATE nonce_current SET state=?,supervisor_epoch=?,transition_ordinal=?,journal_sequence=?,journal_event_sha256=?,authority_receipt_sha256=? WHERE nonce_sha256=?",
+                (target,epoch,ordinal,r.journal_sequence,r.journal_event_sha256,r.authority_receipt_sha256,nonce_sha256))
+            self.con.execute("INSERT INTO nonce_history VALUES(?,?,?,?,?,?,?,?)", (nonce_sha256,ordinal,target,row[2],epoch,r.journal_sequence,r.journal_event_sha256,r.authority_receipt_sha256))
+            self._commit()
+        except Exception:
+            if self.con.in_transaction: self.con.rollback()
+            raise
+        return self._reread_receipt(r.authority_receipt_sha256)
+
+    def bind_nonce_reservation(self, **kw: Any) -> AuthorityReceipt:
+        return self._nonce_transition(expected="RESERVED_PENDING_JOURNAL", target="COMMITTED_NOT_USED", journal_type="CALL_AUTHORITY_RESERVED", **kw)
+
+    def safe_resume_rebind(self, *, validated: ValidatedJournal, nonce_sha256: str, epoch: str) -> AuthorityReceipt:
+        row = self.con.execute("SELECT origin_supervisor_epoch FROM nonce_current WHERE nonce_sha256=?", (nonce_sha256,)).fetchone()
+        if row is None or epoch == row[0] or find_event(validated, "SUPERVISOR_RECOVERED", supervisor_epoch=epoch) is None:
+            raise AuthorityIntegrityError("SAFE_RESUME_REQUIRES_NEW_RECOVERED_EPOCH")
+        for forbidden in ("CALL_START_COMMITTED", "AUTHORITY_NONCE_CONSUMED", "CALL_OUTCOME_RECORDED", "CALL_OUTCOME_UNKNOWN", "NONCE_RETIRED"):
+            if find_event(validated, forbidden, nonce_sha256=nonce_sha256) is not None:
+                raise AuthorityIntegrityError("SAFE_RESUME_FORBIDDEN_HISTORY_PRESENT")
+        return self._nonce_transition(
+            validated=validated, nonce_sha256=nonce_sha256, epoch=epoch,
+            expected="COMMITTED_NOT_USED", target="COMMITTED_NOT_USED", journal_type="CALL_SAFE_RESUME_AUTHORIZED",
+            required_event_bindings={
+                "safe_resume_before_call_start": True,
+                "owner_authority_valid": True,
+                "transaction_lock_exclusive": True,
+                "required_scope_fence_active": True,
+            },
+        )
+
+    def consume_call_start(self, **kw: Any) -> AuthorityReceipt:
+        return self._nonce_transition(expected="COMMITTED_NOT_USED", target="CALL_START_COMMITTED", journal_type="CALL_START_COMMITTED", **kw)
+
+    def record_outcome(self, **kw: Any) -> AuthorityReceipt:
+        return self._nonce_transition(expected="CALL_START_COMMITTED", target="OUTCOME_RECORDED", journal_type="CALL_OUTCOME_RECORDED", require_cas_outcome=True, **kw)
+
+    def classify_unknown_consumed(self, **kw: Any) -> AuthorityReceipt:
+        return self._nonce_transition(expected="CALL_START_COMMITTED", target="UNKNOWN_CONSUMED", journal_type=None, **kw)
+
+    def retire_recorded(self, **kw: Any) -> AuthorityReceipt:
+        return self._nonce_transition(expected="OUTCOME_RECORDED", target="RETIRED", journal_type=None, **kw)
+
+    def abandon_before_call(self, **kw: Any) -> AuthorityReceipt:
+        return self._nonce_transition(expected="COMMITTED_NOT_USED", target="RETIRED", journal_type="NONCE_RETIRED", required_event_bindings={"retirement_kind":"NO_CALL_ABANDONMENT"}, **kw)
+
+    def quarantine_orphan(self, **kw: Any) -> AuthorityReceipt:
+        return self._nonce_transition(expected="RESERVED_PENDING_JOURNAL", target="RETIRED", journal_type="NONCE_RETIRED", required_event_bindings={"retirement_kind":"ORPHAN_QUARANTINE"}, **kw)
+
+    def nonce_call_allowed(self, *, validated: ValidatedJournal, nonce_sha256: str, epoch: str) -> bool:
+        row = self.con.execute("SELECT * FROM nonce_current WHERE nonce_sha256=?", (nonce_sha256,)).fetchone()
+        if row is None or row[1] != "CALL_START_COMMITTED" or row[5] != epoch or validated.transaction_id != row[2]: return False
+        common = {
+            "nonce_sha256": nonce_sha256, "request_sha256": row[8], "authority_id": row[3],
+            "contract_sha256": row[7], "supervisor_epoch": epoch,
+        }
+        start = find_event(validated, "CALL_START_COMMITTED", **common)
+        consumed = find_event(validated, "AUTHORITY_NONCE_CONSUMED", authority_receipt_sha256=row[12], **common)
+        return start is not None and consumed is not None and epoch_proven(validated, epoch)
+
+    def verify_receipt_chains(self) -> None:
+        latest: dict[tuple[str, str], str] = {}
+        for kind,key in self.con.execute("SELECT DISTINCT record_kind,record_key_sha256 FROM authority_receipts"):
+            rows = self.con.execute("SELECT receipt_json FROM authority_receipts WHERE record_kind=? AND record_key_sha256=? ORDER BY transition_ordinal",(kind,key)).fetchall()
+            previous = None
+            for ordinal,(text,) in enumerate(rows,1):
+                data=json.loads(text); digest=data.pop("authority_receipt_sha256")
+                if (
+                    data.get("schema") != "critical_apply.authority_receipt.v1"
+                    or data["transition_ordinal"] != ordinal
+                    or data["previous_receipt_sha256"] != previous
+                    or hashlib.sha256(canonical_json_dumps(data).encode()).hexdigest()!=digest
+                ):
+                    raise AuthorityIntegrityError("AUTHORITY_RECEIPT_CHAIN_INVALID")
+                previous=digest
+            latest[(kind,key)] = previous
+        for scope_hash, receipt_sha in self.con.execute("SELECT scope_hash,authority_receipt_sha256 FROM scope_lease_current"):
+            if latest.get(("SCOPE_LEASE", scope_hash)) != receipt_sha:
+                raise AuthorityIntegrityError("SCOPE_CURRENT_RECEIPT_NOT_CHAIN_HEAD")
+        for nonce_sha, receipt_sha in self.con.execute("SELECT nonce_sha256,authority_receipt_sha256 FROM nonce_current"):
+            if latest.get(("NONCE", nonce_sha)) != receipt_sha:
+                raise AuthorityIntegrityError("NONCE_CURRENT_RECEIPT_NOT_CHAIN_HEAD")
+
+    def pragma_snapshot(self) -> Mapping[str, Any]:
+        return {name:self.con.execute(f"PRAGMA {name}").fetchone()[0] for name in ("journal_mode","synchronous","foreign_keys","trusted_schema","application_id","user_version","busy_timeout","wal_autocheckpoint")}
+
+
+def _require_hashes(*values: str) -> None:
+    if not all(is_sha256(v) for v in values): raise AuthorityDBError("INVALID_SHA256_BINDING")
+
+
+def classify_scope_crash_state(*, reservation: bool, acquisition: bool, release_intent: bool, release_recorded: bool, db_state: str | None, exact: bool = True) -> str:
+    if not exact: return "AUTHORITY_INTEGRITY_HOLD"
+    if release_recorded: return "RELEASE_COMPLETE" if db_state == "RELEASED" else "AUTHORITY_INTEGRITY_HOLD"
+    if release_intent:
+        return {"ACTIVE":"RELEASE_DB_PENDING","RELEASE_PENDING":"RELEASE_IN_PROGRESS","RELEASED":"RELEASE_ACK_PENDING"}.get(db_state,"AUTHORITY_INTEGRITY_HOLD")
+    if db_state in ("RELEASE_PENDING","RELEASED"): return "DB_AHEAD_OF_JOURNAL"
+    if acquisition: return "ACTIVE_PROVEN" if db_state == "ACTIVE" else "AUTHORITY_INTEGRITY_HOLD"
+    if reservation:
+        return {None:"AUTHORITY_STORE_LOSS_OR_ROLLBACK","RESERVED_PENDING_JOURNAL":"BIND_PENDING","JOURNAL_COMMITTED":"ACTIVATION_PENDING","ACTIVE":"ACTIVE_UNACKNOWLEDGED"}.get(db_state,"AUTHORITY_INTEGRITY_HOLD")
+    return {None:"NOT_RESERVED","RESERVED_PENDING_JOURNAL":"ORPHAN_PENDING","ACTIVE":"ACTIVE_UNACKNOWLEDGED"}.get(db_state,"AUTHORITY_INTEGRITY_HOLD")
