new file mode 100644
index 000000000..27e05ce68
--- /dev/null
+++ b/scripts/critical_apply_cas.py
@@ -0,0 +1,359 @@
+#!/usr/bin/env python3
+"""Descriptor-bound content-addressed capture for Critical Apply.
+
+Source bytes are read and hashed from one retained descriptor. Publication is
+same-filesystem, no-overwrite, fsync ordered, reopened and rehashed before the
+canonical journal is synced and an ACK can be returned.
+"""
+from __future__ import annotations
+
+import hashlib
+import os
+import secrets
+import stat
+from dataclasses import asdict, dataclass
+from pathlib import Path
+from typing import Any, Callable, Mapping
+
+from critical_apply_contracts import canonical_json_dumps
+from critical_apply_journal import JournalIdempotencyAck, JournalWriterToken, append_event_idempotent
+from critical_apply_atomic_io import EvidenceIOError, validate_relative_path
+
+CAS_CAPTURE_SCHEMA = "critical_apply.cas_capture.v1"
+
+
+class CASError(EvidenceIOError):
+    pass
+
+
+class CASIntegrityError(CASError):
+    pass
+
+
+class CASCaptureHold(CASError):
+    pass
+
+
+class CASCrash(RuntimeError):
+    """Deterministic offline failpoint; persisted or orphan state is preserved."""
+
+
+@dataclass(frozen=True)
+class DescriptorIdentity:
+    st_dev: int
+    st_ino: int
+    st_uid: int
+    st_gid: int
+    st_mode: int
+    st_nlink: int
+    st_size: int
+    st_mtime_ns: int
+    st_ctime_ns: int
+
+    @classmethod
+    def from_stat(cls, st: os.stat_result) -> "DescriptorIdentity":
+        return cls(st.st_dev, st.st_ino, st.st_uid, st.st_gid, st.st_mode, st.st_nlink, st.st_size, st.st_mtime_ns, st.st_ctime_ns)
+
+    def to_json(self) -> dict[str, Any]:
+        return asdict(self)
+
+
+@dataclass
+class RegisteredSource:
+    root_fd: int
+    fd: int
+    relative_path: str
+    identity: DescriptorIdentity
+    hardlinks_allowed: bool = False
+    _closed: bool = False
+
+    def close(self) -> None:
+        if not self._closed:
+            os.close(self.fd)
+            self._closed = True
+
+    def __enter__(self) -> "RegisteredSource":
+        return self
+
+    def __exit__(self, *_: object) -> None:
+        self.close()
+
+
+class RegisteredRoot:
+    """Retained O_DIRECTORY|O_NOFOLLOW root used for safe openat traversal."""
+
+    def __init__(self, path: Path):
+        self.path = Path(path).absolute()
+        _reject_symlink_chain(self.path)
+        self.fd = os.open(self.path, os.O_RDONLY | os.O_DIRECTORY | getattr(os, "O_NOFOLLOW", 0))
+        st = os.fstat(self.fd)
+        if not stat.S_ISDIR(st.st_mode):
+            os.close(self.fd)
+            raise CASError("REGISTERED_ROOT_NOT_DIRECTORY", str(path))
+        self.identity = (st.st_dev, st.st_ino)
+        self._closed = False
+
+    def open_source(self, relative_path: str, *, allow_hardlinks: bool = False) -> RegisteredSource:
+        rel = validate_relative_path(relative_path)
+        parts = rel.parts
+        parent_fd = os.dup(self.fd)
+        try:
+            for part in parts[:-1]:
+                nxt = os.open(part, os.O_RDONLY | os.O_DIRECTORY | getattr(os, "O_NOFOLLOW", 0), dir_fd=parent_fd)
+                os.close(parent_fd)
+                parent_fd = nxt
+            fd = os.open(parts[-1], os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0), dir_fd=parent_fd)
+        except OSError as exc:
+            raise CASError("REGISTERED_SOURCE_OPEN_REJECTED", relative_path) from exc
+        finally:
+            os.close(parent_fd)
+        st = os.fstat(fd)
+        if not stat.S_ISREG(st.st_mode):
+            os.close(fd)
+            raise CASError("SOURCE_NOT_REGULAR", relative_path)
+        if not allow_hardlinks and st.st_nlink != 1:
+            os.close(fd)
+            raise CASCaptureHold("SOURCE_HARDLINK_POLICY_HOLD", f"nlink={st.st_nlink}")
+        return RegisteredSource(self.fd, fd, str(rel), DescriptorIdentity.from_stat(st), allow_hardlinks)
+
+    def close(self) -> None:
+        if not self._closed:
+            os.close(self.fd)
+            self._closed = True
+
+    def __enter__(self) -> "RegisteredRoot":
+        return self
+
+    def __exit__(self, *_: object) -> None:
+        self.close()
+
+
+@dataclass(frozen=True)
+class CASCaptureAck:
+    schema: str
+    sha256: str
+    byte_count: int
+    object_relative_path: str
+    deduplicated: bool
+    descriptor_before: Mapping[str, Any]
+    descriptor_after: Mapping[str, Any]
+    journal_ack: Mapping[str, Any]
+
+    def to_json(self) -> dict[str, Any]:
+        return asdict(self)
+
+
+def _reject_symlink_chain(path: Path) -> None:
+    absolute = path.absolute()
+    current = Path(absolute.anchor)
+    for part in absolute.parts[1:]:
+        current /= part
+        st = os.lstat(current)
+        if stat.S_ISLNK(st.st_mode):
+            raise CASError("SYMLINK_ANCESTOR_REJECTED", str(current))
+
+
+def _fdatasync(fd: int) -> None:
+    (os.fdatasync if hasattr(os, "fdatasync") else os.fsync)(fd)
+
+
+def _hash_fd(fd: int) -> tuple[str, int]:
+    os.lseek(fd, 0, os.SEEK_SET)
+    h = hashlib.sha256()
+    count = 0
+    while True:
+        chunk = os.read(fd, 1024 * 1024)
+        if not chunk:
+            break
+        h.update(chunk)
+        count += len(chunk)
+    return h.hexdigest(), count
+
+
+def _fail(name: str, failpoint: str | None) -> None:
+    if failpoint == name:
+        raise CASCrash(name)
+
+
+class DescriptorCAS:
+    def __init__(self, transaction_root: Path, *, writer_token: JournalWriterToken):
+        self.transaction_root = Path(transaction_root).resolve(strict=True)
+        self.writer_token = writer_token
+        if writer_token.root_realpath != str(self.transaction_root):
+            raise CASError("WRITER_TOKEN_ROOT_MISMATCH", writer_token.root_realpath)
+        self.cas_path = self.transaction_root / "cas"
+        created = False
+        try:
+            self.cas_path.mkdir(mode=0o700)
+            created = True
+        except FileExistsError:
+            pass
+        if created:
+            root_fd = os.open(self.transaction_root, os.O_RDONLY | os.O_DIRECTORY | getattr(os, "O_NOFOLLOW", 0))
+            try:
+                os.fsync(root_fd)
+            finally:
+                os.close(root_fd)
+        _reject_symlink_chain(self.cas_path)
+        self.cas_fd = os.open(self.cas_path, os.O_RDONLY | os.O_DIRECTORY | getattr(os, "O_NOFOLLOW", 0))
+        self._closed = False
+
+    def close(self) -> None:
+        if not self._closed:
+            os.close(self.cas_fd)
+            self._closed = True
+
+    def __enter__(self) -> "DescriptorCAS":
+        return self
+
+    def __exit__(self, *_: object) -> None:
+        self.close()
+
+    def _open_shard(self, shard: str) -> tuple[int, bool]:
+        created = False
+        try:
+            os.mkdir(shard, 0o700, dir_fd=self.cas_fd)
+            created = True
+        except FileExistsError:
+            pass
+        fd = os.open(shard, os.O_RDONLY | os.O_DIRECTORY | getattr(os, "O_NOFOLLOW", 0), dir_fd=self.cas_fd)
+        return fd, created
+
+    @staticmethod
+    def _verify_object(shard_fd: int, name: str, expected_sha: str, expected_size: int) -> None:
+        try:
+            fd = os.open(name, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0), dir_fd=shard_fd)
+        except FileNotFoundError as exc:
+            raise CASIntegrityError("REFERENCED_CAS_OBJECT_MISSING", expected_sha) from exc
+        try:
+            st = os.fstat(fd)
+            if not stat.S_ISREG(st.st_mode) or st.st_nlink != 1:
+                raise CASIntegrityError("CAS_OBJECT_IDENTITY_INVALID", expected_sha)
+            actual, count = _hash_fd(fd)
+            if actual != expected_sha or count != expected_size:
+                raise CASIntegrityError("HASH_COLLISION_OR_CORRUPTION_FATAL", expected_sha)
+        finally:
+            os.close(fd)
+
+    def capture(
+        self,
+        source: RegisteredSource,
+        *,
+        event_id: str,
+        event_type: str = "CAS_CAPTURED",
+        phase: str = "PREPARING",
+        failpoint: str | None = None,
+        chunk_hook: Callable[[int], None] | None = None,
+        event_bindings: Mapping[str, Any] | None = None,
+    ) -> CASCaptureAck:
+        if source._closed:
+            raise CASError("SOURCE_DESCRIPTOR_CLOSED", source.relative_path)
+        before = DescriptorIdentity.from_stat(os.fstat(source.fd))
+        if before != source.identity:
+            raise CASCaptureHold("SOURCE_IDENTITY_CHANGED_BEFORE_CAPTURE", source.relative_path)
+        if not stat.S_ISREG(before.st_mode) or (before.st_nlink != 1 and not source.hardlinks_allowed):
+            raise CASCaptureHold("SOURCE_DESCRIPTOR_POLICY_HOLD", source.relative_path)
+        os.lseek(source.fd, 0, os.SEEK_SET)
+        tmp_name = f".capture-{secrets.token_hex(16)}.tmp"
+        # Hash determines the shard, so the first durable temporary lives in CAS
+        # root (same filesystem) and is linked into the final shard later.
+        tmp_fd = os.open(tmp_name, os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0), 0o600, dir_fd=self.cas_fd)
+        h = hashlib.sha256()
+        count = 0
+        chunks = 0
+        try:
+            while True:
+                data = os.read(source.fd, 1024 * 1024)
+                if not data:
+                    break
+                view = memoryview(data)
+                done = 0
+                while done < len(view):
+                    n = os.write(tmp_fd, view[done:])
+                    if n <= 0:
+                        raise CASError("CAS_TEMP_SHORT_WRITE", tmp_name)
+                    done += n
+                h.update(data)
+                count += len(data)
+                chunks += 1
+                if chunk_hook is not None:
+                    chunk_hook(chunks)
+            _fail("after_stream_before_temp_sync", failpoint)
+            _fdatasync(tmp_fd)
+            _fail("after_temp_sync_before_identity_check", failpoint)
+        finally:
+            os.close(tmp_fd)
+        after = DescriptorIdentity.from_stat(os.fstat(source.fd))
+        if after != before or count != before.st_size:
+            raise CASCaptureHold("SOURCE_MUTATED_DURING_CAPTURE", source.relative_path)
+        digest = h.hexdigest()
+        shard = digest[:2]
+        shard_fd, shard_created = self._open_shard(shard)
+        published = False
+        deduplicated = False
+        try:
+            _fail("before_publish", failpoint)
+            try:
+                os.link(tmp_name, digest, src_dir_fd=self.cas_fd, dst_dir_fd=shard_fd, follow_symlinks=False)
+                published = True
+                os.unlink(tmp_name, dir_fd=self.cas_fd)
+            except FileExistsError:
+                deduplicated = True
+                self._verify_object(shard_fd, digest, digest, count)
+                os.unlink(tmp_name, dir_fd=self.cas_fd)
+            _fail("after_publish_before_parent_fsync", failpoint)
+            os.fsync(shard_fd)
+            if shard_created:
+                os.fsync(self.cas_fd)
+            _fail("after_parent_fsync_before_reopen", failpoint)
+            self._verify_object(shard_fd, digest, digest, count)
+            _fail("after_rehash_before_journal", failpoint)
+        finally:
+            os.close(shard_fd)
+        object_rel = f"cas/{shard}/{digest}"
+        proposal = {
+            "schema": "critical_apply.event.v2",
+            "transaction_id": self.writer_token.transaction_id,
+            "event_type": event_type,
+            "phase": phase,
+            "payload_path": object_rel,
+            "payload_sha256": digest,
+            "payload_byte_count": count,
+            "cas_capture": {
+                "schema": CAS_CAPTURE_SCHEMA,
+                "source_relative_path": source.relative_path,
+                "descriptor_before": before.to_json(),
+                "descriptor_after": after.to_json(),
+                "object_relative_path": object_rel,
+            },
+        }
+        protected = set(proposal) | {"sequence", "previous_event_sha256", "event_sha256", "proposal_sha256", "event_id"}
+        if any(key in protected for key in (event_bindings or {})):
+            raise CASError("CAS_EVENT_BINDING_OVERRIDES_PROTECTED_FIELD", event_id)
+        proposal.update(event_bindings or {})
+        journal_ack = append_event_idempotent(
+            self.transaction_root,
+            proposal,
+            event_id=event_id,
+            writer_token=self.writer_token,
+            failpoint="after_event_sync_before_ack" if failpoint == "after_journal_sync_before_ack" else None,
+        )
+        return CASCaptureAck(
+            CAS_CAPTURE_SCHEMA,
+            digest,
+            count,
+            object_rel,
+            deduplicated,
+            before.to_json(),
+            after.to_json(),
+            journal_ack.to_json(),
+        )
+
+    def verify_reference(self, sha256: str, byte_count: int) -> None:
+        if len(sha256) != 64 or any(c not in "0123456789abcdef" for c in sha256):
+            raise CASIntegrityError("CAS_SHA256_INVALID", sha256)
+        shard_fd = os.open(sha256[:2], os.O_RDONLY | os.O_DIRECTORY | getattr(os, "O_NOFOLLOW", 0), dir_fd=self.cas_fd)
+        try:
+            self._verify_object(shard_fd, sha256, sha256, byte_count)
+        finally:
+            os.close(shard_fd)
