{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "common-reasoner-decision.v1",
  "title": "Common Reasoner vMesh Decision",
  "description": "A typed decision-policy output. This service decides what kind of turn this is, what obligation exists, what support is required, what capabilities are required, and what minimum lane class is safe. It does NOT render final answers, execute tools, or write memory.",
  "type": "object",
  "required": [
    "decision_schema", "service", "mode", "turn_id", "visible_user_text_hash",
    "intent_family", "obligation", "required_support", "required_capabilities",
    "minimum_lane_class", "safe_escalation_allowed", "fail_closed_if_unavailable",
    "rendering_allowed", "tool_execution_allowed", "memory_write_allowed",
    "context_write_allowed", "policy_reasons", "confidence", "ambiguity_score"
  ],
  "properties": {
    "decision_schema": { "type": "string", "const": "common-reasoner-decision.v1" },
    "service": { "type": "string", "const": "common-reasoner-vmesh" },
    "mode": { "type": "string", "const": "decision_only" },
    "turn_id": { "type": "string" },
    "visible_user_text_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]+$" },
    "intent_family": {
      "type": "string",
      "enum": [
        "simple_chat", "short_ambiguous_no_context", "short_ambiguous_with_valid_context",
        "memory_lookup", "context_bridge_read", "runtime_status", "debug_diagnostic",
        "tool_action", "planning_request", "unsafe_or_unsupported"
      ]
    },
    "obligation": {
      "type": "string",
      "enum": [
        "answer_only", "clarify", "memory_required", "context_required",
        "runtime_tool_required", "tool_required", "high_reasoning_required", "fail_closed"
      ]
    },
    "required_support": {
      "type": "array",
      "items": { "type": "string" }
    },
    "required_capabilities": {
      "type": "object",
      "required": ["tools", "memory", "context_bridge", "runtime_status", "high_reasoning"],
      "properties": {
        "tools": { "type": "boolean" },
        "memory": { "type": "boolean" },
        "context_bridge": { "type": "boolean" },
        "runtime_status": { "type": "boolean" },
        "high_reasoning": { "type": "boolean" }
      }
    },
    "minimum_lane_class": {
      "type": "string",
      "enum": ["cheap_chat", "continuity_capable", "memory_capable", "context_capable", "tool_capable", "high_reasoning_tool", "fail_closed"]
    },
    "safe_escalation_allowed": { "type": "boolean" },
    "fail_closed_if_unavailable": { "type": "boolean" },
    "rendering_allowed": { "type": "boolean", "const": false },
    "tool_execution_allowed": { "type": "boolean", "const": false },
    "memory_write_allowed": { "type": "boolean", "const": false },
    "context_write_allowed": { "type": "boolean", "const": false },
    "policy_reasons": {
      "type": "array",
      "items": { "type": "string" }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "ambiguity_score": { "type": "number", "minimum": 0, "maximum": 1 }
  },
  "additionalProperties": false
}
